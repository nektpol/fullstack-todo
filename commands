------------------Login

$response = Invoke-RestMethod -Uri "http://localhost:3000/auth/login" `
-Method POST `
-Headers @{ "Content-Type" = "application/json" } `
-Body '{"email":"test@test.com","password":"123456"}'

$token = $response.token

------------------Create new todo

Invoke-RestMethod -Uri "http://localhost:3000/todos" `
-Method POST `
-Headers @{
    "Authorization" = "Bearer $token"
    "Content-Type" = "application/json"
} `
-Body '{"title":"Old Title","description":"Old Desc","frequency":"daily"}'

-------------------- Get todos

Invoke-RestMethod -Uri "http://localhost:3000/todos" `
-Method GET `
-Headers @{ "Authorization" = "Bearer $token" }

---------------------- Update todos
4805a271-eb6f-4970-8918-6c6ffe6f96e1

Invoke-RestMethod -Uri "http://localhost:3000/todos/{4805a271-eb6f-4970-8918-6c6ffe6f96e1}" `
-Method PUT `
-Headers @{
    "Authorization" = "Bearer $token"
    "Content-Type" = "application/json"
} `
-Body '{"title":"Updated Title","description":"Updated Desc","frequency":"weekly"}'